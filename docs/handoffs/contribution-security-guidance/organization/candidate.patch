+      description: Identify the public repository, component and affected version or commit.
+    validations:
+      required: true
+  - type: textarea
+    id: summary
+    attributes:
+      label: Summary
+      description: Describe the suspected vulnerability and expected security boundary.
+    validations:
+      required: true
+  - type: textarea
+    id: reproduction
+    attributes:
